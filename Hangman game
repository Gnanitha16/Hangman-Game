
import random


class Login:
    def __init__(self):
        self.username = ""
        self.password = ""

    def login(self):
        print("=" * 40)
        print("LOGIN")
        print("=" * 40)

        username = input("Enter Username: ").strip()
        password = input("Enter Password: ").strip()

        if username and password:
            self.username = username
            self.password = password
            print("Login Successful!\n")
            return True

        print("Invalid Login!\n")
        return False


class ScoreBoard:
    def __init__(self):
        self.scores = {}

    def add(self, user, points):
        if user not in self.scores:
            self.scores[user] = 0

        self.scores[user] += points

    def show(self, user):
        print("\n===== SCORE BOARD =====")
        print("Player :", user)
        print("Score  :", self.scores.get(user, 0))
        print("=======================\n")


class HangmanGame:
    def __init__(self):
        self.words = [
            "python",
            "object",
            "student",
            "computer",
            "project",
            "college",
            "program"
        ]
        self.lives = 6

    def play(self):
        word = random.choice(self.words)
        guessed = []

        while self.lives > 0:
            display = ""

            for ch in word:
                if ch in guessed:
                    display += ch + " "
                else:
                    display += "_ "

            print("\nWord:", display)
            print("Lives:", self.lives)

            if all(ch in guessed for ch in word):
                print("Congratulations!")
                print("You guessed the word:", word)
                return True

            letter = input("Guess a letter: ").lower().strip()

            if len(letter) != 1 or not letter.isalpha():
                print("Enter only one alphabet.")
                continue

            if letter in guessed:
                print("Already guessed.")
                continue

            guessed.append(letter)

            if letter in word:
                print("Correct!")
            else:
                self.lives -= 1
                print("Wrong guess!")

        print("\nGame Over!")
        print("The word was:", word)
        return False


class Menu:
    def __init__(self):
        self.login_obj = Login()
        self.score = ScoreBoard()

    def run(self):
        while True:
            print("=" * 40)
            print("        HANGMAN GAME")
            print("=" * 40)
            print("1. Login")
            print("2. Play Game")
            print("3. Score Board")
            print("4. Exit")

            choice = input("Enter choice: ").strip()

            if choice == "1":
                self.login_obj.login()

            elif choice == "2":
                if self.login_obj.username == "":
                    print("Please login first.\n")
                else:
                    game = HangmanGame()

                    if game.play():
                        self.score.add(
                            self.login_obj.username,
                            10
                        )

            elif choice == "3":
                if self.login_obj.username:
                    self.score.show(
                        self.login_obj.username
                    )
                else:
                    print("Please login first.\n")

            elif choice == "4":
                print("Thank you for playing!")
                break

            else:
                print("Invalid choice. Please try again.\n")


if __name__ == "__main__":
    Menu().run()

